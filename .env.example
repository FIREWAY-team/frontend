# 골목119 프론트엔드 환경변수 예시
# 실제 값은 .env.local (git-ignored)에 넣는다.

# ── 사이트 URL ─────────────────────────────────────
# OG 이미지·절대경로용. 배포 시 실제 도메인 · 로컬에선 생략 가능.
# 배포 도메인: https://fireroad.shop (2026-09-07 확정)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── BE API 프록시 대상 ─────────────────────────────
# BFF(/api/*)가 서버에서 이 값으로 프록시한다. 브라우저에 노출되지 않는다.
BACKEND_API_URL=http://localhost:8080

# ── Kakao Map JavaScript SDK ───────────────────────
# 카카오 개발자 콘솔에서 발급 · 배포 도메인 등록 필수(도메인 잠금).
# 브라우저에 노출되는 값이지만 잠금이 걸려 있으면 다른 사이트가 우리 할당량을 못 태운다.
NEXT_PUBLIC_KAKAO_MAP_APP_KEY=

# ── 목/실 API 전환 ─────────────────────────────────
# "true"면 mock, 아니면 라이브 BE 호출 (CLAUDE.md §Mock → Live 격리막)
NEXT_PUBLIC_USE_MOCK=true
